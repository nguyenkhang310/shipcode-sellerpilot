{
  "expo": {
    "name": "ShipCode SellerPilot",
    "slug": "sellerpilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/shipcode-logo.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cho phép SellerPilot dùng Face ID để mở khóa tài khoản của bạn."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Cho phép SellerPilot dùng Face ID để mở khóa tài khoản của bạn.",
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép SellerPilot chọn ảnh sản phẩm để tạo bản nháp đăng bán.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-audio",
        { "microphonePermission": "Cho phép SellerPilot dùng micro khi bạn trò chuyện Live." }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/shipcode-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": { "backgroundColor": "#FFFFFF" }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.sellerpilot.app",
      "icon": "./assets/shipcode-logo.png"
    },
    "android": {
      "package": "vn.sellerpilot.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/shipcode-logo-app.png"
    }
  }
}
