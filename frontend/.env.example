# Public setting, bundled into the app. Never put secrets here.
# Usually leave this unset: web uses its current hostname, native development
# uses Metro's host, and npm run demo supplies this computer's current LAN IP.
# Only override for a separately hosted API; do not copy a teammate's Wi-Fi IP.
# EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
# Android emulator override, when needed:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
