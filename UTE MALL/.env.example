# bootstrap_demo.py generates a private SECRET_KEY in .env on first setup.
# Never commit .env or paste credentials into README.
SECRET_KEY=
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5011
ENABLE_EXTERNAL_PAYMENTS=0
COOKIE_SECURE=0
