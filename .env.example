# FILE MẪU CHO NHÓM - được commit lên GitHub, KHÔNG dán key thật vào file này.
# Tạo .env ở thư mục gốc: cp .env.example .env (chỉ khi chưa có .env).
# Windows PowerShell: Copy-Item .env.example .env
# Dán key thật vào .env. File .env được Git bỏ qua; mỗi thành viên tự cấu hình.
# Backend reads root .env, then backend/.env (if present); shell variables win.
APP_NAME=ShipCode SellerPilot
DATABASE_URL=sqlite:///./data/sellerpilot.db
SHOP_DATABASE_PATH=../UTE MALL/instance/ecommerce.db
SHOP_TIMEZONE=Asia/Ho_Chi_Minh
DEMO_MODE=true
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 1. BẮT BUỘC khi dùng Gemini: dán key vào GEMINI_API_KEY trong .env.
# Direct API is the recommended demo path. Keys stay on the backend only.
# Create a Gemini key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_PROJECT_ID=
# 2. TÙY CHỌN: key thứ 2/3; không có thì để trống, không cần điền đủ 3 key.
# Optional keys from projects you own. Fill actual project IDs from AI Studio.
# Unknown/same project IDs share one quota group; keys do not multiply quota.
GEMINI_API_KEY_2=
GEMINI_PROJECT_ID_2=
GEMINI_API_KEY_3=
GEMINI_PROJECT_ID_3=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_GENERATION_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=2048
# Separate room for detailed business plans; short chat keeps the smaller budget.
GEMINI_ADVICE_MAX_OUTPUT_TOKENS=4096
# 3. TÙY CHỌN Groq: dán GROQ_API_KEY và đổi GROQ_FALLBACK_ENABLED=true để bật.
# Không dùng Groq thì giữ false và để trống key. https://console.groq.com/keys
# Optional backup: enable only after adding your Groq key and checking its limits.
# Qwen backup accepts at most 3 images. Gemini keeps support for all 6.
GROQ_FALLBACK_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# 4. CÁC PROVIDER KHÁC: giữ nguyên nếu đang dùng AI_PROVIDER=gemini.
# Optional Antigravity CLI uses your own signed-in session.
ANTIGRAVITY_BINARY=agy
ANTIGRAVITY_MODEL=gemini-3.8-flash-low
ANTIGRAVITY_GENERATION_TIMEOUT_SECONDS=120
# Optional OpenCode provider: free gateway access may be restricted (403).
# Tested CLI: opencode-ai@1.18.30. OpenCode v2 uses a different server API.
OPENCODE_MODEL=glm-5.3-flash-free
OPENCODE_BINARY=opencode
OPENCODE_GENERATION_TIMEOUT_SECONDS=90
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_HEALTH_TIMEOUT_SECONDS=2
OLLAMA_GENERATION_TIMEOUT_SECONDS=180
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_OUTPUT_TOKENS=256
OLLAMA_KEEP_ALIVE=30m
# 5. EXTENSION: không dán key Gemini/Groq vào biến này.
# Generated by npm run extension:setup. Pairing credential, never a model API key.
BROWSER_CONNECTOR_TOKEN=
# Sau khi lưu .env: npm run ai:check; sau đó npm run demo.
# Nếu API đang chạy, tự khởi động lại để nạp cấu hình mới.
