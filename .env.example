# Backend reads root .env, then backend/.env (if present); shell variables win.
APP_NAME=ShipCode SellerPilot
DATABASE_URL=sqlite:///./data/sellerpilot.db
SHOP_DATABASE_PATH=../UTE MALL/instance/ecommerce.db
SHOP_TIMEZONE=Asia/Ho_Chi_Minh
DEMO_MODE=true
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# opencode starts a private local OpenCode server, using only Muse Spark Free.
AI_PROVIDER=opencode
OPENCODE_MODEL=muse-spark-1.3-contributor-free
OPENCODE_GENERATION_TIMEOUT_SECONDS=90
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_HEALTH_TIMEOUT_SECONDS=2
OLLAMA_GENERATION_TIMEOUT_SECONDS=180
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_OUTPUT_TOKENS=256
OLLAMA_KEEP_ALIVE=30m
